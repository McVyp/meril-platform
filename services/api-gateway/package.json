    "@aws-sdk/s3-request-presigner": "^3.1160.0",
    "@bufbuild/protobuf": "^2.16.0",
    "@connectrpc/connect": "^2.3.0",
    "@connectrpc/connect-node": "^2.3.0",
    "@meril/db": "workspace:*",
    "@prisma/adapter-pg": "^7.10.1",
    "@temporalio/client": "^1.25.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
