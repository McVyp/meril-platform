{
  "name": "meril-platform",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write . && pnpm format:py && pnpm format:go && pnpm format:proto",
    "format:py": "uvx ruff format .",
    "format:go": "gofmt -w services/recommender",
    "format:proto": "buf format -w"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "turbo": "latest"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26.13.0 <27"
  }
}
